+++ b/VLA/VLAAdapter/lang_spectral/grad_probe.py
@@ -0,0 +1,323 @@
+"""Q9 + Q11 probes: how much of each weight update is driven by language tokens,
+and how the language-token representations' spectrum evolves.
+
+Q9 -- token-type decomposition of the weight gradient
+-----------------------------------------------------
+For a linear layer y = W x applied at every sequence position t,
+
+    G = dL/dW = sum_t  d_t x_t^T          (d_t = dL/dy_t, x_t = input at t)
+
+so G splits *exactly* into G = sum_tau G_tau, with G_tau summed over the
+positions of token type tau (vision / lang / action / other).  Per probed
+layer and type we log
+
+  * ``energy``  ||G_tau||_F^2 / sum_tau' ||G_tau'||_F^2
+  * ``credit``  <G_tau, G> / ||G||^2            (sums to 1 over types: SGD's split)
+  * ``budget``  <G_tau, U> / <G, U>             (sums to 1: the split of the
+                first-order loss decrease of the *actual* step U = -(W_after - W_before),
+                whatever the optimizer did to the spectrum)
+  * ``erank``   effective rank exp(H(sigma / sum sigma)) of G_tau
+  * ``top_overlap``  fraction of ||G_tau||^2 inside U's top-k left/right singular
+                subspace -- does the optimizer's dominant subspace serve language?
+
+``budget / credit`` > 1 means the optimizer amplifies that token type relative
+to plain SGD; < 1 means it suppresses it.  This is the quantity that should
+differ between AdamW, Muon and Pion if the "whitening amplifies weak language
+directions / high-pass removes them" hypothesis is right.
+
+Notes
+  * Only gradients flowing through the probed LLM linears are measured.
+  * Under DDP each rank sees its local gradient (before all-reduce) while the
+    step is global; the probe runs on rank 0 only, so treat values as
+    single-shard estimates.
+  * The weight-decay part of the step (-lr*wd*W) is removed using the
+    optimizer's own lr/wd when ``decay_of`` is given; otherwise it is included.
+
+Q11 -- representation spectra per token type
+--------------------------------------------
+For decoder layers we log, per token type, the stable rank
+||H||_F^2/||H||_2^2 and erank of the centered token matrix H (n_tau x d), and
+the cosine between the mean language and mean vision token (a cheap
+"representation mixing" indicator).
+"""
+from __future__ import annotations
+
+import json
+import math
+import re
+from pathlib import Path
+from typing import Callable, Dict, Iterable, List, Optional
+
+import torch
+import torch.nn as nn
+
+from .token_types import ACTION, LANG, OTHER, PROPRIO, TYPE_NAMES, VISION, TokenTypeContext
+
+DEFAULT_TYPES = (VISION, LANG, ACTION, OTHER)
+
+
+# ---------------------------------------------------------------------------
+# spectral helpers
+# ---------------------------------------------------------------------------
+
+def erank(s: torch.Tensor, eps: float = 1e-12) -> float:
+    s = s.float().clamp_min(0)
+    total = s.sum()
+    if total <= eps:
+        return 0.0
+    p = s / total
+    p = p[p > 0]
+    return float(torch.exp(-(p * p.log()).sum()))
+
+
+def stable_rank(s: torch.Tensor, eps: float = 1e-12) -> float:
+    s = s.float()
+    if s.numel() == 0 or s[0] <= eps:
+        return 0.0
+    return float((s ** 2).sum() / (s[0] ** 2))
+
+
+def _svdvals(m: torch.Tensor) -> torch.Tensor:
+    return torch.linalg.svdvals(m.float())
+
+
+# ---------------------------------------------------------------------------
+# module selection
+# ---------------------------------------------------------------------------
+
+_LAYER_RE = re.compile(r"layers\.(\d+)\.")
+
+
+def select_llm_linears(model: nn.Module, layer_stride: int = 4,
+                       name_filter: Optional[Callable[[str], bool]] = None) -> Dict[str, nn.Linear]:
+    """LLM decoder linears (q/k/v/o, gate/up/down), every ``layer_stride``-th layer."""
+    out = {}
+    for name, mod in model.named_modules():
+        if not isinstance(mod, nn.Linear) or "language_model" not in name:
+            continue
+        if "lora_" in name:          # under PEFT, probe the base layer only
+            continue
+        m = _LAYER_RE.search(name)
+        if m is None or int(m.group(1)) % max(1, layer_stride) != 0:
+            continue
+        if name_filter is not None and not name_filter(name):
+            continue
+        out[name] = mod
+    return out
+
+
+def select_decoder_layers(model: nn.Module, layer_stride: int = 4) -> Dict[str, nn.Module]:
+    out = {}
+    for name, mod in model.named_modules():
+        if "language_model" in name and re.search(r"layers\.(\d+)$", name):
+            if int(name.rsplit(".", 1)[-1]) % max(1, layer_stride) == 0:
+                out[name] = mod
+    return out
+
+
+def _weight_of(mod: nn.Module) -> torch.Tensor:
+    base = getattr(mod, "base_layer", None)
+    return (base if base is not None else mod).weight
+
+
+# ---------------------------------------------------------------------------
+# probe
+# ---------------------------------------------------------------------------
+
+class TokenGradProbe:
+    """Hooks that record token-level factors (x_t, d_t) on probe steps only.
+
+    Usage inside the training loop (see the patched ``finetune_pion.py``)::
+
+        probe.begin_step(active=is_probe_step)       # before the first micro-batch forward
+        ... forward / backward (all micro-batches) ...
+        if probe.active: probe.snapshot_weights()   # right before optimizer.step()
+        optimizer.step()
+        metrics = probe.end_step()                  # right after optimizer.step()
+    """
+
+    def __init__(self, model: nn.Module, ctx: TokenTypeContext, *, layer_stride: int = 4,
+                 types: Iterable[int] = DEFAULT_TYPES, top_k: int = 16, max_rows: int = 8192,
+                 repr_spectra: bool = True, log_path: Optional[Path] = None,
+                 decay_of: Optional[Callable[[torch.Tensor], Optional[float]]] = None):
+        self.ctx = ctx
+        self.types = tuple(types)
+        self.top_k = top_k
+        self.max_rows = max_rows
+        self.log_path = Path(log_path) if log_path is not None else None
+        self.decay_of = decay_of
+        self.linears = select_llm_linears(model, layer_stride)
+        self.layers = select_decoder_layers(model, layer_stride) if repr_spectra else {}
+        self.active = False
+        self.step = None
+        self._x: Dict[str, List[torch.Tensor]] = {}
+        self._d: Dict[str, List[torch.Tensor]] = {}
+        self._t: Dict[str, List[torch.Tensor]] = {}
+        self._w0: Dict[str, torch.Tensor] = {}
+        self._repr: Dict[str, Dict[str, float]] = {}
+        self._handles = []
+        for name, mod in self.linears.items():
+            self._handles.append(mod.register_forward_hook(self._linear_hook(name)))
+        for name, mod in self.layers.items():
+            self._handles.append(mod.register_forward_hook(self._layer_hook(name)))
+        if not self.linears:
+            raise RuntimeError("TokenGradProbe found no LLM linear layers to probe")
+
+    # -- hooks ---------------------------------------------------------------
+    def _linear_hook(self, name: str):
+        def hook(_mod, inputs, output):
+            if not (self.active and torch.is_grad_enabled()):
+                return
+            x = inputs[0]
+            if x.dim() != 3 or not isinstance(output, torch.Tensor) or not output.requires_grad:
+                return
+            t = self.ctx.types_for(x.shape[0], x.shape[1])
+            if t is None:
+                return
+            keep = t.reshape(-1) >= 0
+            x2 = x.detach().reshape(-1, x.shape[-1])[keep]
+            t2 = t.reshape(-1)[keep]
+            # One slot per (micro-batch, forward).  Under gradient checkpointing the
+            # first forward runs without grad and is skipped above; the recompute
+            # is captured, so each micro-batch still yields exactly one slot.
+            slot = len(self._x.setdefault(name, []))
+            self._x[name].append(x2.to(torch.bfloat16))
+            self._t.setdefault(name, []).append(t2)
+
+            def grad_hook(g, name=name, slot=slot, keep=keep):
+                d2 = g.detach().reshape(-1, g.shape[-1])[keep].to(torch.bfloat16)
+                lst = self._d.setdefault(name, [])
+                while len(lst) <= slot:
+                    lst.append(None)
+                lst[slot] = d2
+            output.register_hook(grad_hook)
+        return hook
+
+    def _layer_hook(self, name: str):
+        @torch.no_grad()
+        def hook(_mod, _inputs, output):
+            if not (self.active and torch.is_grad_enabled()):
+                return
+            h = output[0] if isinstance(output, (tuple, list)) else output
+            if h.dim() != 3:
+                return
+            t = self.ctx.types_for(h.shape[0], h.shape[1])
+            if t is None or name in self._repr:
+                return
+            flat, tt = h.detach().reshape(-1, h.shape[-1]).float(), t.reshape(-1)
+            stats, means = {}, {}
+            for tau in (VISION, LANG, ACTION):
+                rows = flat[tt == tau]
+                if rows.shape[0] < 2:
+                    continue
+                if rows.shape[0] > self.max_rows:
+                    rows = rows[torch.randperm(rows.shape[0], device=rows.device)[: self.max_rows]]
+                means[tau] = rows.mean(0)
+                s = _svdvals(rows - means[tau])
+                key = TYPE_NAMES[tau]
+                stats[f"{key}/stable_rank"] = stable_rank(s)
+                stats[f"{key}/erank"] = erank(s)
+                stats[f"{key}/norm"] = float(rows.norm(dim=1).mean())
+            if LANG in means and VISION in means:
+                stats["lang_vision_mean_cos"] = float(torch.nn.functional.cosine_similarity(
+                    means[LANG], means[VISION], dim=0))
+            self._repr[name] = stats
+        return hook
+
+    # -- step protocol -----------------------------------------------------------
+    def begin_step(self, active: bool, step: Optional[int] = None) -> None:
+        self.active = bool(active)
+        self.step = step
+        self._x, self._d, self._t, self._w0, self._repr = {}, {}, {}, {}, {}
+
+    @torch.no_grad()
+    def snapshot_weights(self) -> None:
+        if not self.active:
+            return
+        for name, mod in self.linears.items():
+            self._w0[name] = _weight_of(mod).detach().float().clone()
+
+    @torch.no_grad()
+    def end_step(self) -> Dict[str, float]:
+        if not self.active:
+            return {}
+        metrics: Dict[str, float] = {}
+        per_type_acc: Dict[str, List[float]] = {}
+        for name, mod in self.linears.items():
+            if name not in self._x or name not in self._d or name not in self._w0:
+                continue
+            pairs = [(x, d, t) for x, d, t in zip(self._x[name], self._d[name], self._t[name]) if d is not None]
+            if not pairs:
+                continue
+            X = torch.cat([p[0] for p in pairs]).float()
+            D = torch.cat([p[1] for p in pairs]).float()
+            T = torch.cat([p[2] for p in pairs])
+            W1 = _weight_of(mod).detach().float()
+            U = self._w0[name] - W1                      # actual descent step (up to lr)
+            wd = self.decay_of(_weight_of(mod)) if self.decay_of is not None else None
+            if wd:
+                U = U - wd * self._w0[name]              # remove decoupled weight decay
+            G = D.T @ X
+            g2 = float((G * G).sum())
+            gu = float((G * U).sum())
+            u_svd = None
+            if self.top_k > 0:
+                uu, us, uvh = torch.linalg.svd(U, full_matrices=False)
+                k = min(self.top_k, us.numel())
+                u_svd = (uu[:, :k], uvh[:k])
+            short = _short(name)
+            e_tot = 0.0
+            rows = {}
+            for tau in self.types:
+                m = T == tau
+                if m.sum() == 0:
+                    continue
+                Gt = D[m].T @ X[m]
+                e = float((Gt * Gt).sum())
+                e_tot += e
+                rec = {
+                    "energy": e,
+                    "credit": float((Gt * G).sum()) / g2 if g2 > 0 else float("nan"),
+                    "budget": float((Gt * U).sum()) / gu if gu != 0 else float("nan"),
+                    "erank": erank(_svdvals(Gt)),
+                    "n_tokens": float(m.sum()),
+                }
+                if u_svd is not None and e > 0:
+                    L, R = u_svd
+                    proj = L.T @ Gt @ R.T
+                    rec["top_overlap"] = float((proj * proj).sum()) / e
+                rows[tau] = rec
+            for tau, rec in rows.items():
+                rec["energy"] = rec["energy"] / e_tot if e_tot > 0 else float("nan")
+                if rec["credit"] and not math.isnan(rec["credit"]) and abs(rec["credit"]) > 1e-8:
+                    rec["amplification"] = rec["budget"] / rec["credit"]
+                key = TYPE_NAMES[tau]
+                for k, v in rec.items():
+                    metrics[f"lang_probe/grad/{short}/{key}/{k}"] = v
+                    per_type_acc.setdefault(f"{key}/{k}", []).append(v)
+            metrics[f"lang_probe/grad/{short}/step_cos_sgd"] = gu / (math.sqrt(g2) * float(U.norm()) + 1e-12)
+        for k, vals in per_type_acc.items():
+            vals = [v for v in vals if not math.isnan(v)]
+            if vals:
+                metrics[f"lang_probe/grad_mean/{k}"] = sum(vals) / len(vals)
+        for name, stats in self._repr.items():
+            for k, v in stats.items():
+                metrics[f"lang_probe/repr/{_short(name)}/{k}"] = v
+        if self.log_path is not None and metrics:
+            self.log_path.parent.mkdir(parents=True, exist_ok=True)
+            with self.log_path.open("a") as f:
+                f.write(json.dumps({"step": self.step, **metrics}) + "\n")
+        self.active = False
+        self._x, self._d, self._t, self._w0, self._repr = {}, {}, {}, {}, {}
+        return metrics
+
+    def remove(self) -> None:
+        for h in self._handles:
+            h.remove()
+        self._handles = []
+
+
+def _short(name: str) -> str:
+    m = _LAYER_RE.search(name)
+    layer = m.group(1) if m else "x"
+    return f"L{layer}.{name.rsplit('.', 1)[-1]}"
