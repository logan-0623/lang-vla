@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+# Q8 readout: evaluate one checkpoint under four instruction modes.
+#
+#   CKPT=outputs/lang_matrix/<run>--15000_chkpt SUITE=libero_goal bash scripts/eval_lang_modes.sh
+#
+# On LIBERO-Goal (one shared scene) the useful numbers are
+#   SR_orig                 task success with the correct instruction
+#   SR_other                success of the *env's* task when the policy is given another task's
+#                           instruction -- a language-following policy should FAIL here, so this is
+#                           the vision-shortcut rate
+#   SR_empty, SR_shuffle    no instruction / scrambled word order
+#   LRI = SR_orig - SR_other   language-reliance index
+# On Object / Spatial expect LRI ~ 0 for every optimizer (the layout decides the task).
+
+set -euo pipefail
+export PYTHONPATH="$(pwd):${PYTHONPATH:-}"
+ckpt=${CKPT:?set CKPT=<checkpoint dir>}
+suite=${SUITE:-libero_goal}
+trials=${TRIALS:-50}
+modes=${MODES:-"orig other empty shuffle"}
+note=${NOTE:-$(basename "${ckpt}")}
+
+for mode in ${modes}; do
+  CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0} \
+  python experiments/robot/libero/run_libero_eval.py \
+    --pretrained_checkpoint "${ckpt}" \
+    --task_suite_name "${suite}" \
+    --use_proprio True --num_images_in_input 2 --use_film False --use_pro_version True \
+    --num_trials_per_task "${trials}" \
+    --instruction_mode "${mode}" --instruction_shift 1 \
+    --run_id_note "${note}"
+done
