+"""Language-modality diagnostics and optimizers for VLA-Adapter + Pion.
+
+* ``token_types``  -- label every LLM position as vision / lang / action / other.
+* ``grad_probe``   -- Q9: token-type decomposition of weight gradients and of the
+                      actual optimizer step; Q11: per-type representation spectra.
+* ``optim_lang``   -- Q11 remedy: ``LangGuard`` (Muon or Pion with a protected
+                      language-input subspace) and its ``LangSubspaceTracker``.
+"""
+from .token_types import LANG, VISION, ACTION, OTHER, TYPE_NAMES, TokenTypeContext, build_token_types
+from .grad_probe import TokenGradProbe, erank, stable_rank
+
+__all__ = [
+    "LANG", "VISION", "ACTION", "OTHER", "TYPE_NAMES",
+    "TokenTypeContext", "build_token_types",
+    "TokenGradProbe", "erank", "stable_rank",
+]
diff --git a/VLA/VLAAdapter/lang_spectral/check_math_numpy.py b/VLA/VLAAdapter/lang_spectral/check_math_numpy.py
new file mode 100644
index 0000000..65c0b7c
--- /dev/null
+++ b/VLA/VLAAdapter/lang_spectral/check_math_numpy.py
@@ -0,0 +1,111 @@
+"""Torch-free check of the math behind lang_spectral (run: python -m lang_spectral.check_math_numpy).
+
+1. The token-type split of a weight gradient is exact, and both the SGD split
+   (credit) and the split of the actual step (budget) sum to 1.
+2. On a synthetic layer where language-token inputs carry a weak gradient in
+   their own input subspace, compare how much of the step's first-order loss
+   decrease is routed through language tokens under SGD, Muon, Pion
+   (pure suppression, k_p=0) and LangGuard.  This is the Q9 hypothesis in
+   miniature, using the exact polynomials from pion_optim.muon.
+"""
+import numpy as np
+
+MUON = (3.4445, -4.7750, 2.0315)
+
+
+def ns(X, steps=5):
+    X = X / (np.linalg.norm(X) + 1e-7)
+    t = X.shape[0] > X.shape[1]
+    if t:
+        X = X.T
+    for _ in range(steps):
+        A = X @ X.T
+        B = A @ X
+        X = MUON[0] * X + MUON[1] * B + MUON[2] * A @ B
+    return X.T if t else X
+
+
+def high_pass(X, kp=0, ks=5):
+    X = X / (np.linalg.norm(X) + 1e-7)
+    t = X.shape[0] > X.shape[1]
+    if t:
+        X = X.T
+    for _ in range(kp):
+        A = X @ X.T
+        X = 1.875 * X + (-1.25 * A + 0.375 * A @ A) @ X
+    for _ in range(ks):
+        A = X @ X.T
+        X = (2.5 * A - 1.5 * A @ A) @ X
+    return X.T if t else X
+
+
+def lang_guard(M, V, rest, mode="ns", gamma=0.5):
+    A = M @ V.T
+    O = rest(M - A @ V)
+    if mode == "ns":
+        O_L = ns(A) @ V
+    else:
+        O_L = (A / np.linalg.norm(A, 2)) @ V
+    return O + gamma * O_L
+
+
+def split(D, X, T, U, types=(0, 1)):
+    G = D.T @ X
+    out = {}
+    for tau in types:
+        Gt = D[T == tau].T @ X[T == tau]
+        out[tau] = (float((Gt * G).sum() / (G * G).sum()), float((Gt * U).sum() / (G * U).sum()))
+    return G, out
+
+
+def main(seed=0):
+    rng = np.random.default_rng(seed)
+    d_in, d_out, n_vis, n_lang = 96, 64, 400, 40
+    # vision inputs live in a 24-dim subspace, language inputs in a disjoint 6-dim subspace
+    Q, _ = np.linalg.qr(rng.normal(size=(d_in, d_in)))
+    Bv, Bl = Q[:, :24], Q[:, 24:30]
+    Xv = rng.normal(size=(n_vis, 24)) @ Bv.T
+    Xl = rng.normal(size=(n_lang, 6)) @ Bl.T
+    # vision tokens: strong, low-rank output gradient; language tokens: weak gradient
+    Dv = (rng.normal(size=(n_vis, 4)) * np.array([3.0, 1.0, 0.5, 0.3])) @ rng.normal(size=(4, d_out))
+    Dl = rng.normal(size=(n_lang, 3)) @ rng.normal(size=(3, d_out)) * 0.15
+    X, D = np.vstack([Xv, Xl]), np.vstack([Dv, Dl])
+    T = np.array([0] * n_vis + [1] * n_lang)
+    G = D.T @ X
+
+    # 1) exactness
+    _, sgd = split(D, X, T, G)
+    assert abs(sum(c for c, _ in sgd.values()) - 1) < 1e-9
+    assert abs(sum(b for _, b in sgd.values()) - 1) < 1e-9
+
+    # language-input basis as the tracker would estimate it from language rows
+    _, _, Vh = np.linalg.svd(Xl, full_matrices=False)
+    V = Vh[:6]
+    # 3) the split is orthogonal: rest part has no component on the language subspace
+    M_R = G - (G @ V.T) @ V
+    assert np.abs(M_R @ V.T).max() < 1e-9
+
+    steps = {
+        "SGD": G,
+        "Muon": ns(G),
+        "Pion(kp=0)": high_pass(G, 0, 5),
+        "Pion(kp=1)": high_pass(G, 1, 4),
+        "LangGuard-Muon(ns, g=.5)": lang_guard(G, V, ns, "ns", 0.5),
+        "LangGuard-Pion(kp=0, ns, g=.5)": lang_guard(G, V, lambda M: high_pass(M, 0, 5), "ns", 0.5),
+        "LangGuard-Pion(kp=0, lin, g=.5)": lang_guard(G, V, lambda M: high_pass(M, 0, 5), "linear", 0.5),
+    }
+    sg = np.linalg.svd(G / np.linalg.norm(G), compute_uv=False)
+    print(f"normalized top singular values of G: {np.round(sg[:5], 3)}")
+    print("(pure suppression keeps only directions above ~0.816, i.e. holding >2/3 of the energy)")
+    print(f"language credit under SGD: {sgd[1][0]:.4f}\n")
+    print(f"{'step':32s} {'lang budget':>12s} {'amplif.':>9s} {'vis budget':>11s} {'dirs>0.5':>9s}")
+    for name, U in steps.items():
+        _, s = split(D, X, T, U)
+        assert abs(s[0][1] + s[1][1] - 1) < 1e-6
+        su = np.linalg.svd(U / np.linalg.svd(U, compute_uv=False)[0], compute_uv=False)
+        print(f"{name:32s} {s[1][1]:12.4f} {s[1][1] / s[1][0]:9.2f} {s[0][1]:11.4f} {int((su > 0.5).sum()):9d}")
+    print("\nchecks passed")
+
+
+if __name__ == "__main__":
+    main()
