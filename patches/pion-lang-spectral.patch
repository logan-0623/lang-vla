@@ -0,0 +1,92 @@
+"""Token-type labels for the VLA-Adapter LLM sequence.
+
+VLA-Adapter (Prismatic + Qwen2.5-0.5B) feeds the LLM this sequence
+(see ``PrismaticForConditionalGeneration._build_multimodal_attention``)::
+
+    [BOS] [P vision patches] [input_ids[1:] = prompt text ... action-query slots ... stop]
+
+so a multimodal position ``m`` maps to ``input_ids`` index ``m - P`` for
+``m >= 1 + P``.  Proprio is *not* inserted into the LLM sequence during
+training (it goes to the action head), so normally ``P == NUM_PATCHES``.
+``P`` is inferred from the runtime sequence length, so any extra prefix tokens
+beyond ``num_vision`` are labelled ``PROPRIO``.
+
+Action-query slots are found with the same helper the model uses to replace
+them (``_process_action_masks`` on the *unshifted* labels).
+"""
+from __future__ import annotations
+
+from typing import Callable, Optional
+
+import torch
+
+PAD, OTHER, VISION, PROPRIO, LANG, ACTION = -1, 0, 1, 2, 3, 4
+TYPE_NAMES = {VISION: "vision", PROPRIO: "proprio", LANG: "lang", ACTION: "action", OTHER: "other"}
+IGNORE_INDEX = -100
+
+
+def build_token_types(
+    input_ids: torch.Tensor,
+    labels: torch.Tensor,
+    attention_mask: Optional[torch.Tensor],
+    mm_len: int,
+    num_vision: int,
+    action_mask_fn: Callable[[torch.Tensor], torch.Tensor],
+) -> torch.Tensor:
+    """Return a (B, mm_len) long tensor of token-type ids."""
+    B, T = input_ids.shape
+    P = mm_len - T
+    if P < 0 or P < num_vision:
+        raise ValueError(f"sequence length {mm_len} inconsistent with T={T}, num_vision={num_vision}")
+    device = input_ids.device
+
+    text = torch.full((B, T), LANG, dtype=torch.long, device=device)
+    labels = labels.to(device)
+    text[labels != IGNORE_INDEX] = OTHER          # stop token and anything else that is supervised
+    text[action_mask_fn(labels).bool()] = ACTION   # action-query slots (replaced by learned queries)
+    text[:, 0] = OTHER                             # BOS
+    if attention_mask is not None:
+        text[attention_mask.to(device) == 0] = PAD
+
+    types = torch.full((B, mm_len), OTHER, dtype=torch.long, device=device)
+    types[:, 0] = text[:, 0]
+    types[:, 1 : 1 + num_vision] = VISION
+    if P > num_vision:
+        types[:, 1 + num_vision : 1 + P] = PROPRIO
+    types[:, 1 + P :] = text[:, 1:]
+    return types
+
+
+class TokenTypeContext:
+    """Holds the current batch so forward hooks can label any LLM-length tensor.
+
+    Call :meth:`set_batch` before each forward pass.  :meth:`types_for` returns
+    ``None`` for tensors whose sequence length is not an LLM sequence (e.g.
+    vision-tower activations), so hooks can skip them.
+    """
+
+    def __init__(self, num_vision: int, action_mask_fn: Callable[[torch.Tensor], torch.Tensor]):
+        self.num_vision = int(num_vision)
+        self.action_mask_fn = action_mask_fn
+        self._batch = None
+        self._cache: dict[int, torch.Tensor] = {}
+
+    def set_batch(self, batch, device) -> None:
+        self._batch = (
+            batch["input_ids"].to(device),
+            batch["labels"].to(device),
+            batch.get("attention_mask").to(device) if batch.get("attention_mask") is not None else None,
+        )
+        self._cache = {}
+
+    def types_for(self, batch_size: int, seq_len: int) -> Optional[torch.Tensor]:
+        if self._batch is None:
+            return None
+        input_ids, labels, attention_mask = self._batch
+        if input_ids.shape[0] != batch_size or seq_len < input_ids.shape[1] + self.num_vision:
+            return None
+        if seq_len not in self._cache:
+            self._cache[seq_len] = build_token_types(
+                input_ids, labels, attention_mask, seq_len, self.num_vision, self.action_mask_fn
+            )
+        return self._cache[seq_len]
