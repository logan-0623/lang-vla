+++ b/VLA/VLAAdapter/lang_spectral/optim_lang.py
@@ -0,0 +1,213 @@
+"""Q11 remedy: protect the language-input subspace from spectral whitening / high-pass.
+
+Idea
+----
+Pion's high-pass NS keeps dominant singular directions of the momentum M and
+drives the tail to 0.  If language tokens contribute weak, low-energy gradient
+directions inside the shared LLM weights (Q9 measures whether they do), the
+high-pass removes exactly those.  Muon, conversely, lifts them to the same
+magnitude as everything else.  LangGuard makes this choice explicit:
+
+    V   = top-r orthonormal basis of the *input* activations at language-token
+          positions for this layer (rows in R^{in}, tracked online, EMA'd)
+    M_L = (M V^T) V          component of the update acting on language inputs
+    M_R = M - M_L            everything else
+    O   = F_rest(M_R) + gamma * F_lang(M V^T) V
+
+    F_rest = high-pass NS (rest="pion")  or  Muon NS (rest="muon")
+    F_lang = NS                  (lang_mode="ns":      whiten inside the language subspace)
+           = X / ||X||_2         (lang_mode="linear":  keep its own spectrum -- a low-pass /
+                                                        pass-through, nothing suppressed)
+
+``gamma`` is the explicit "language budget".  ``gamma=0`` with rest="muon"
+is *not* identical to Muon (the language subspace is removed from the update);
+use ``lang_mode="off"`` for the exact Muon / Pion baseline inside the same code
+path.
+
+The step skeleton (sharding, async all_gather, scaling by
+``scale_factor * sqrt(max(out, in))``) is copied from ``pion_optim.muon`` so
+results are directly comparable to the paper's optimizers.
+
+Distributed note: every rank runs a full forward, so every rank's tracker has
+a (local-batch) basis for every layer; the rank that owns parameter p uses its
+own basis.  No extra communication.
+"""
+from __future__ import annotations
+
+from typing import Dict, Optional
+
+import torch
+import torch.distributed as dist
+import torch.nn as nn
+from torch import Tensor
+
+from pion_optim.muon import fast_newtonschulz, high_pass_ns
+
+from .grad_probe import select_llm_linears
+from .token_types import LANG, TokenTypeContext
+
+
+class LangSubspaceTracker:
+    """Online top-r basis of language-token inputs for each LLM linear layer.
+
+    Uses a frequent-directions style update: stack sqrt(beta)*S V (previous
+    sketch) with sqrt(1-beta)*X_lang/sqrt(n) (this step) and keep the top-r
+    right singular vectors.
+    """
+
+    def __init__(self, model: nn.Module, ctx: TokenTypeContext, *, rank: int = 32, beta: float = 0.9,
+                 max_rows: int = 1024, min_rows: int = 16, layer_stride: int = 1):
+        self.ctx = ctx
+        self.rank = int(rank)
+        self.beta = float(beta)
+        self.max_rows = int(max_rows)
+        self.min_rows = int(min_rows)
+        self.linears = select_llm_linears(model, layer_stride=layer_stride)
+        self._by_param: Dict[int, str] = {}
+        self._rows: Dict[str, list] = {}
+        self._V: Dict[str, Tensor] = {}
+        self._S: Dict[str, Tensor] = {}
+        self._handles = []
+        for name, mod in self.linears.items():
+            w = getattr(mod, "base_layer", mod).weight
+            self._by_param[id(w)] = name
+            self._handles.append(mod.register_forward_hook(self._hook(name)))
+
+    def _hook(self, name: str):
+        @torch.no_grad()
+        def hook(_mod, inputs, _output):
+            if not torch.is_grad_enabled():
+                return
+            x = inputs[0]
+            if x.dim() != 3:
+                return
+            t = self.ctx.types_for(x.shape[0], x.shape[1])
+            if t is None:
+                return
+            rows = x.detach().reshape(-1, x.shape[-1])[t.reshape(-1) == LANG]
+            if rows.numel():
+                self._rows.setdefault(name, []).append(rows.to(torch.bfloat16))
+        return hook
+
+    @torch.no_grad()
+    def update(self) -> None:
+        """Fold this step's language rows into each layer's basis. Call once per optimizer step, before step()."""
+        for name, chunks in self._rows.items():
+            X = torch.cat(chunks).float()
+            if X.shape[0] < self.min_rows:
+                continue
+            if X.shape[0] > self.max_rows:
+                X = X[torch.randperm(X.shape[0], device=X.device)[: self.max_rows]]
+            X = X * ((1.0 - self.beta) / X.shape[0]) ** 0.5
+            if name in self._V:
+                prev = (self.beta ** 0.5) * self._S[name][:, None] * self._V[name]
+                X = torch.cat([prev, X])
+            _, S, Vh = torch.linalg.svd(X, full_matrices=False)
+            r = min(self.rank, Vh.shape[0])
+            self._V[name], self._S[name] = Vh[:r].contiguous(), S[:r].contiguous()
+        self._rows = {}
+
+    def basis_for(self, p: Tensor) -> Optional[Tensor]:
+        name = self._by_param.get(id(p))
+        return None if name is None else self._V.get(name)
+
+    def remove(self) -> None:
+        for h in self._handles:
+            h.remove()
+        self._handles = []
+
+
+def lang_guard_direction(M: Tensor, V: Optional[Tensor], *, rest: str, lang_mode: str, gamma: float,
+                         promotion_steps: int, suppression_steps: int, ns_steps: int) -> Tensor:
+    """Update direction for one (out, in) matrix. Returns bf16 (out, in)."""
+    def f_rest(X: Tensor) -> Tensor:
+        if rest == "pion":
+            return high_pass_ns(X, promotion_steps, suppression_steps)
+        if rest == "muon":
+            return fast_newtonschulz(X, steps=ns_steps)
+        raise ValueError(f"unknown rest optimizer: {rest}")
+
+    if lang_mode == "off" or V is None:
+        return f_rest(M)
+    V = V.to(M.device, torch.float32)
+    Mf = M.float()
+    A = Mf @ V.T                      # (out, r): M restricted to the language input subspace
+    M_R = Mf - A @ V
+    O = f_rest(M_R).float()
+    if gamma != 0.0 and A.abs().sum() > 0:
+        if lang_mode == "ns":
+            O_L = fast_newtonschulz(A, steps=ns_steps).float() @ V
+        elif lang_mode == "linear":
+            O_L = (A / (torch.linalg.matrix_norm(A, ord=2) + 1e-7)) @ V
+        else:
+            raise ValueError(f"unknown lang_mode: {lang_mode}")
+        O = O + gamma * O_L
+    return O.to(torch.bfloat16)
+
+
+class LangGuard(torch.optim.Optimizer):
+    """Muon / Pion with a protected language-input subspace (see module docstring)."""
+
+    def __init__(self, params, tracker: LangSubspaceTracker, lr=0.02, weight_decay=0.01, momentum=0.95,
+                 nesterov=True, rest="muon", lang_mode="ns", gamma=0.5, promotion_steps=0, ns_steps=5,
+                 scale_factor=0.2, rank=None, world_size=None):
+        if (rank is None) or (world_size is None):
+            raise Exception("world_size and rank params required. For single-GPU use, pass rank=0 and world_size=1.")
+        self.rank, self.world_size, self.tracker = rank, world_size, tracker
+        defaults = dict(lr=lr, weight_decay=weight_decay, momentum=momentum, nesterov=nesterov, rest=rest,
+                        lang_mode=lang_mode, gamma=gamma, promotion_steps=promotion_steps, ns_steps=ns_steps,
+                        scale_factor=scale_factor)
+        params = [*params]
+        param_groups = []
+        for size in {p.numel() for p in params}:
+            b = torch.empty(world_size, size, dtype=torch.bfloat16, device="cuda")
+            param_groups.append(dict(params=[p for p in params if p.numel() == size], update_buffer=b,
+                                     update_buffer_views=[b[i] for i in range(world_size)]))
+        super().__init__(param_groups, defaults)
+
+    @torch.no_grad()
+    def step(self):
+        for group in self.param_groups:
+            update_buffer: Tensor = group["update_buffer"]
+            views: list = group["update_buffer_views"]
+            params: list = group["params"]
+            handle, params_world = None, None
+            kp = group["promotion_steps"]
+            ks = max(0, group["ns_steps"] - kp)
+
+            def update_prev():
+                handle.wait()
+                for p_world, g_world in zip(params_world, views):
+                    p_world.mul_(1 - group["lr"] * group["weight_decay"])
+                    p_world.add_(g_world.view_as(p_world),
+                                 alpha=-group["lr"] * group["scale_factor"] * max(p_world.size(-2), p_world.size(-1)) ** 0.5)
+
+            for base_i in range(len(params))[:: self.world_size]:
+                if base_i + self.rank < len(params):
+                    p = params[base_i + self.rank]
+                    g = p.grad
+                    if g is None:
+                        g = views[self.rank]
+                        g.zero_()
+                    else:
+                        state = self.state[p]
+                        if "momentum_buffer" not in state:
+                            state["momentum_buffer"] = torch.zeros_like(g)
+                        buf: Tensor = state["momentum_buffer"]
+                        buf.lerp_(g, 1 - group["momentum"])
+                        g = g.lerp_(buf, group["momentum"]) if group["nesterov"] else buf
+                        if g.ndim != 2:
+                            raise ValueError("LangGuard expects 2D (out, in) weights")
+                        g = lang_guard_direction(
+                            g, self.tracker.basis_for(p), rest=group["rest"], lang_mode=group["lang_mode"],
+                            gamma=group["gamma"], promotion_steps=kp, suppression_steps=ks,
+                            ns_steps=group["ns_steps"]).flatten()
+                else:
+                    g = views[self.rank]
+                    g.zero_()
+                if base_i > 0:
+                    update_prev()
+                handle = dist.all_gather_into_tensor(update_buffer, g, async_op=True)
+                params_world = params[base_i: base_i + self.world_size]
+            if params_world is not None:
+                update_prev()
