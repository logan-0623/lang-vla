@@ -0,0 +1,98 @@
+#!/usr/bin/env bash
+# lang_spectral experiment matrix for VLA-Adapter (Q8/Q9/Q11).
+#
+# One arm per call:   ARM=<arm> bash scripts/run_lang_matrix.sh
+#
+# Arms (V / L / A optimizers; everything else identical to scripts/run_pion.sh):
+#   adamw        AdamW        / AdamW               / AdamW         (O=AdamW, as run_adamw.sh)
+#   muon         Muon         / Muon                / Muon
+#   pion         Muon         / Muon                / DefaultPion   (paper recipe)
+#   pion_L       Muon         / DefaultPion         / DefaultPion   (high-pass on the LLM too)
+#   lg_muon      Muon         / LangGuardMuon       / DefaultPion   (protected language subspace)
+#   lg_pion      Muon         / LangGuardPion       / DefaultPion
+#   lg_off       Muon         / LangGuardMuon(off)  / DefaultPion   (same code path as `pion`; sanity check)
+#
+# Default suite is LIBERO-Goal: its 10 tasks share one scene, so the policy
+# cannot succeed without reading the instruction.  Object/Spatial are the
+# "language-free" control (one layout per task).
+#
+# The probe (Q9/Q11) runs on every arm; it is read-only and adds ~1 SVD sweep
+# every LANG_PROBE_EVERY steps on rank 0.
+
+set -euo pipefail
+export PYTHONPATH="$(pwd):${PYTHONPATH:-}"
+
+arm=${ARM:?set ARM=adamw|muon|pion|pion_L|lg_muon|lg_pion|lg_off}
+current_time=$(date +%m%d-%H%M%S)
+data_name=${DATA_NAME:-libero_goal_no_noops}
+max_steps=${MAX_STEPS:-15000}
+save_freq=${SAVE_FREQ:-2500}
+batch_size=${BATCH_SIZE:-8}
+lr=${LR:-1e-4}
+wd=${WD:-1e-2}
+seed_note=${SEED_NOTE:-s0}
+nproc=${NPROC:-8}
+probe_every=${LANG_PROBE_EVERY:-100}
+probe_stride=${LANG_PROBE_STRIDE:-4}
+lg_gamma=${LG_GAMMA:-0.5}
+lg_rank=${LG_RANK:-32}
+lg_mode=${LG_MODE:-ns}
+promotion_steps=${PROMOTION_STEPS:-0}   # Pion k_p (0 = pure suppression, paper's VLA default)
+
+V=Muon; L=Muon; A=DefaultPion; O=Muon
+case "${arm}" in
+  adamw)   V=AdamW; L=AdamW; A=AdamW; O=AdamW ;;
+  muon)    V=Muon;  L=Muon;  A=Muon ;;
+  pion)    ;;
+  pion_L)  L=DefaultPion ;;
+  lg_muon) L=LangGuardMuon ;;
+  lg_pion) L=LangGuardPion ;;
+  lg_off)  L=LangGuardMuon; lg_mode=off ;;
+  *) echo "unknown ARM=${arm}" >&2; exit 2 ;;
+esac
+
+out_dir=${OUT_DIR:-outputs/lang_matrix}
+run_id_note=${RUN_ID_NOTE:-${arm}-kp${promotion_steps}-${data_name}-${seed_note}-${current_time}}
+log_file=logs/${run_id_note}.log
+mkdir -p "${out_dir}" logs
+
+CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7} \
+torchrun --standalone --nnodes 1 --nproc-per-node "${nproc}" vla-scripts/finetune_pion.py \
+  --vlm_path pretrained_models/prism-qwen25-extra-dinosiglip-224px-0_5b \
+  --config_file_path pretrained_models/configs \
+  --data_root_dir data/libero \
+  --dataset_name "${data_name}" \
+  --run_root_dir "${out_dir}" \
+  --use_film False \
+  --num_images_in_input 2 \
+  --use_proprio True \
+  --use_lora False \
+  --use_fz True \
+  --use_minivlm True \
+  --image_aug True \
+  --num_steps_before_decay 100000 \
+  --max_steps "${max_steps}" \
+  --save_freq "${save_freq}" \
+  --save_latest_checkpoint_only False \
+  --merge_lora_during_training True \
+  --batch_size "${batch_size}" \
+  --grad_accumulation_steps 1 \
+  --learning_rate "${lr}" \
+  --weight_decay "${wd}" \
+  --lr_ratio 1.0 \
+  --lora_rank 64 \
+  --use_pro_version True \
+  --wandb_project "${data_name}-lang" \
+  --run_id_note "${run_id_note}" \
+  --optimizer_V "${V}" \
+  --optimizer_L "${L}" \
+  --optimizer_A "${A}" \
+  --optimizer_O "${O}" \
+  --pion_promotion_steps "${promotion_steps}" \
+  --pion_ns_steps 5 \
+  --lang_probe_every "${probe_every}" \
+  --lang_probe_layer_stride "${probe_stride}" \
+  --lang_guard_mode "${lg_mode}" \
+  --lang_guard_gamma "${lg_gamma}" \
+  --lang_guard_rank "${lg_rank}" \
+  2>&1 | tee "${log_file}"
